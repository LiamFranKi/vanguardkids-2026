# ⚠️  VPS Zarkiel: NO usar para tráfico público
#
# En 89.117.52.9 Apache ya usa los puertos 80 y 443.
# Nginx puede estar instalado pero no debe competir con Apache.
#
# Para Vanguard Kids usa: deploy/apache-vanguardkids.conf.example
# Ver: deploy/VPS-ZARKIEL.md
#
# Este archivo queda solo como referencia si en el futuro
# cambiáis la arquitectura del servidor.

upstream vanguardkids_next {
    server 127.0.0.1:3012;
    keepalive 64;
}

# server { ... }  — no habilitar en Zarkiel sin replanificar 80/443

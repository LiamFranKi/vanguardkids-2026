# Vanguard Kids — Nginx (proxy a Next.js en PM2)
#
# 1. Copia:  sudo cp deploy/nginx-vanguardkids.conf.example /etc/nginx/sites-available/vanguardkids
# 2. Activa: sudo ln -sf /etc/nginx/sites-available/vanguardkids /etc/nginx/sites-enabled/
# 3. SSL:    sudo certbot --nginx -d vanguardkids.com -d www.vanguardkids.com
# 4. Prueba: sudo nginx -t && sudo systemctl reload nginx
#
# Puerto proxy_pass debe coincidir con PORT en deploy/ecosystem.config.cjs

upstream vanguardkids_next {
    server 127.0.0.1:3010;
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name vanguardkids.com www.vanguardkids.com;

    # Tras certbot, suele añadirse redirect a HTTPS automáticamente.
    location / {
        proxy_pass http://vanguardkids_next;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}


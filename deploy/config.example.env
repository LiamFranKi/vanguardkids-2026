# Copia en el VPS como:  /var/www/vanguardkids/.env.production
# IMPORTANTE: las variables NEXT_PUBLIC_* deben existir ANTES de `npm run build`

NODE_ENV=production
PORT=3010

# Dominio público (útil si añades redirecciones o emails más adelante)
# SITE_URL=https://vanguardkids.com

# WhatsApp — solo dígitos internacionales, sin +
NEXT_PUBLIC_WA_ADMISSION=573000000000
NEXT_PUBLIC_WA_FAMILIES=573000000000

# Google Maps Embed (URLs completas del iframe)
# NEXT_PUBLIC_MAPS_EMBED_KIDS=https://www.google.com/maps/embed?pb=...
# NEXT_PUBLIC_MAPS_EMBED_ACADEMY=https://www.google.com/maps/embed?pb=...

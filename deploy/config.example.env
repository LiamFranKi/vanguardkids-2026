# Copia en el VPS como:  .env.production  (en la raíz del proyecto)
#   cp deploy/config.example.env .env.production
#
# No hace falta un archivo ".env" aparte: Next.js usa .env.production en build.
# NO pongas NODE_ENV aquí (rompe npm ci). PM2 lo define al arrancar la app.
#
# NEXT_PUBLIC_* deben existir ANTES de npm run build
# PORT = puerto interno (mismo que deploy/deploy.local.cjs y Apache)

PORT=3012

# SITE_URL=https://www.tudominio.com

NEXT_PUBLIC_WA_ADMISSION=14079631784
NEXT_PUBLIC_WA_FAMILIES=14079631784

# NEXT_PUBLIC_MAPS_EMBED_KIDS=...
# NEXT_PUBLIC_MAPS_EMBED_ACADEMY=...

# Redes sociales (footer)
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/tu_cuenta
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/tu_pagina
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@tu_canal
# NEXT_PUBLIC_SOCIAL_TIKTOK=https://www.tiktok.com/@tu_cuenta
